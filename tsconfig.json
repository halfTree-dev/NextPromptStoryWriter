{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.mjs",
    "story-env.d.ts",
    "types/**/*.d.ts"
  ]
}